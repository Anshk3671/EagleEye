# ─── Database ─────────────────────────────────────────────
# For local dev (SQLite):
DB_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# For production (PostgreSQL):
# DB_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@host:5432/eagleeye?schema=public

# ─── SMS (Fast2SMS) ──────────────────────────────────────
# Get your key at: https://www.fast2sms.com
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio (alternative)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ─── Email ────────────────────────────────────────────────
# Provider: smtp | sendgrid | console (default: console)
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@eagleeye.in

# SendGrid (alternative)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# ─── Razorpay ─────────────────────────────────────────────
# Get keys at: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
